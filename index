  <script>
    pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
    lucide.createIcons();

    const state = {
      pdfBytes: null,
      fileName: 'document.pdf',
      pdfDoc: null,
      numPages: 0,
      activePageIndex: 1,
      renderScale: 1.5,
      pagesData: [],
      currentTool: 'select', // 'select' | 'text' | 'highlight-free' | 'highlight-box' | 'pen-free' | 'pen-line'
      textColor: '#1e293b',
      fontSize: 24,
      highlightColorName: 'yellow',
      highlightOpacity: 0.4,
      penColor: '#ef4444',
      penWidth: 3,
      isDarkMode: false,
      autoScroll: { active: false, speed: 2, rafId: null },
      history: { undoStack: [], redoStack: [], isRestoring: false, pageSnapshots: new Map() },
      speechRecognition: null,
      isListening: false
    };

    const HIGHLIGHT_COLOR_HEX = {
      yellow: '#facc15',
      green: '#4ade80',
      pink: '#f472b6',
      blue: '#60a5fa'
    };

    function getHighlightRgba(colorName, opacity) {
      const hex = HIGHLIGHT_COLOR_HEX[colorName] || '#facc15';
      const r = parseInt(hex.slice(1, 3), 16);
      const g = parseInt(hex.slice(3, 5), 16);
      const b = parseInt(hex.slice(5, 7), 16);
      return `rgba(${r}, ${g}, ${b}, ${opacity})`;
    }

    const els = {
      pdfFileInput: document.getElementById('pdf-file-input'),
      imageFileInput: document.getElementById('image-file-input'),
      uploadScreen: document.getElementById('upload-screen'),
      dropZone: document.getElementById('drop-zone'),
      btnSelectPdf: document.getElementById('btn-select-pdf'),
      btnLoadSample: document.getElementById('btn-load-sample'),
      btnUploadNew: document.getElementById('btn-upload-new'),
      docFilenameLabel: document.getElementById('doc-filename-label'),
      pdfWorkspace: document.getElementById('pdf-workspace'),
      scrollContainer: document.getElementById('pdf-scroll-container'),
      pagesList: document.getElementById('pages-list'),
      editingToolsGroup: document.getElementById('editing-tools-group'),
      autoscrollGroup: document.getElementById('autoscroll-group'),
      toolButtons: document.querySelectorAll('.tool-btn'),
      hlSwatches: document.querySelectorAll('.hl-swatch'),
      hlOpacitySlider: document.getElementById('hl-opacity-slider'),
