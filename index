      autoScrollSpeedLabel: document.getElementById('autoscroll-speed-label'),
      btnAutoScrollMobile: document.getElementById('btn-autoscroll-mobile'),
      autoScrollMobileIcon: document.getElementById('autoscroll-mobile-icon'),
      mobileAutoScrollBar: document.getElementById('mobile-autoscroll-bar'),
      autoScrollSpeedMobile: document.getElementById('autoscroll-speed-mobile'),
      autoScrollSpeedMobileLabel: document.getElementById('autoscroll-speed-mobile-label'),
      btnDarkMode: document.getElementById('btn-dark-mode'),
