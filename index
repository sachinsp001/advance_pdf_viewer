    function showToast(message, type = 'info') {
      const toast = document.createElement('div');
      const bgClass = type === 'success' ? 'bg-emerald-600 text-white' : type === 'error' ? 'bg-rose-600 text-white' : 'bg-slate-900 text-white border border-slate-700';
      toast.className = `pointer-events-auto flex items-center gap-2 px-4 py-2.5 rounded-xl shadow-xl text-xs font-medium transition-all duration-300 transform translate-y-2 opacity-0 ${bgClass}`;
      toast.innerHTML = `<span>${message}</span>`;
      els.toastContainer.appendChild(toast);
      requestAnimationFrame(() => toast.classList.remove('translate-y-2', 'opacity-0'));
      setTimeout(() => {
        toast.classList.add('translate-y-2', 'opacity-0');
        setTimeout(() => toast.remove(), 300);
      }, 3200);
    }

    function showLoading(title, subtitle, pct = 0) {
      els.loadingTitle.textContent = title;
      els.loadingSubtitle.textContent = subtitle;
      els.loadingProgressBar.style.width = `${Math.min(100, Math.max(0, pct))}%`;
      els.loadingOverlay.classList.remove('hidden');
    }
    function updateLoadingProgress(sub, pct) {
      if (sub) els.loadingSubtitle.textContent = sub;
      els.loadingProgressBar.style.width = `${Math.min(100, Math.max(0, pct))}%`;
    }
    function hideLoading() { els.loadingOverlay.classList.add('hidden'); }

    async function generateSamplePdfBytes() {
      const { PDFDocument, StandardFonts, rgb } = PDFLib;
      const pdfDoc = await PDFDocument.create();
      const fontBold = await pdfDoc.embedFont(StandardFonts.HelveticaBold);
      const fontRegular = await pdfDoc.embedFont(StandardFonts.Helvetica);

      const pages = [
        { title: 'PDF Studio Pro — Sample Document', sub: 'Page 1 of 3 • Overview & Quick Guide', text: ['1. Use the Highlighter tool with opacity slider to highlight text.', '2. Select Pen (Freehand or Straight Line) in Red color to mark notes.', '3. Insert Shapes & Symbols (Arrows, Hand pointer, Stars, Checkmarks).', '4. Use Voice Speech Dictation to speak and add text to the PDF.'] },
        { title: 'Technical Architecture & Highlights', sub: 'Page 2 of 3 • Feature Specifications', text: ['• 100% Client-Side execution using PDF.js, Fabric.js and pdf-lib.', '• Smooth vertical scrolling & Dark Mode PDF Invert toggle.', '• Multi-page undo & redo history (Ctrl+Z / Ctrl+Y).'] },
        { title: 'Approval & Sign-Off', sub: 'Page 3 of 3 • Signature Section', text: ['• Manager Sign-Off: _________________________', '• Date: October 2026', '• Status: Ready for Review'] }
      ];

      pages.forEach((p, idx) => {
        const page = pdfDoc.addPage([612, 792]);
        const { width, height } = page.getSize();
        page.drawRectangle({ x: 40, y: height - 110, width: width - 80, height: 65, color: rgb(0.94, 0.95, 1.0) });
        page.drawText(p.title, { x: 56, y: height - 72, size: 16, font: fontBold, color: rgb(0.18, 0.2, 0.55) });
        page.drawText(p.sub, { x: 56, y: height - 94, size: 11, font: fontRegular, color: rgb(0.35, 0.4, 0.55) });

        let y = height - 160;
        p.text.forEach(line => {
          page.drawText(line, { x: 52, y, size: 12, font: fontRegular, color: rgb(0.15, 0.18, 0.24) });
          y -= 40;
        });

        page.drawRectangle({ x: 52, y: 140, width: width - 104, height: 140, borderColor: rgb(0.78, 0.82, 0.92), borderWidth: 1, color: rgb(0.98, 0.99, 1.0) });
        page.drawText('Interactive Annotation Canvas Area', { x: 72, y: 235, size: 13, font: fontBold, color: rgb(0.25, 0.28, 0.38) });
        page.drawText('Draw straight red lines, arrows, or place symbols here.', { x: 72, y: 210, size: 11, font: fontRegular, color: rgb(0.45, 0.48, 0.58) });
        page.drawText(`Page ${idx + 1} of ${pages.length}`, { x: 52, y: 45, size: 10, font: fontRegular, color: rgb(0.55, 0.58, 0.65) });
      });

      return await pdfDoc.save();
    }

    async function loadPdfFromBytes(uint8Array, fileName = 'document.pdf') {
      try {
        stopAutoScroll();
        showLoading('Loading PDF Document...', 'Parsing pages and workspace', 10);

        state.pdfBytes = uint8Array.slice();
        state.fileName = fileName;
        if (els.docFilenameLabel) {
          els.docFilenameLabel.textContent = fileName;
          els.docFilenameLabel.title = fileName;
        }

        state.pagesData.forEach(p => { if (p.fabricCanvas) p.fabricCanvas.dispose(); });
        state.pagesData = [];
        state.history.undoStack = [];
        state.history.redoStack = [];
        state.history.pageSnapshots.clear();
        updateUndoRedoButtons();
        if (els.pagesList) els.pagesList.innerHTML = '';

        const loadingTask = pdfjsLib.getDocument({ data: uint8Array.slice() });
        state.pdfDoc = await loadingTask.promise;
        state.numPages = state.pdfDoc.numPages;
        state.activePageIndex = 1;

        if (els.totalPagesIndicator) els.totalPagesIndicator.textContent = state.numPages;
        if (els.currentPageIndicator) els.currentPageIndicator.textContent = '1';

        if (els.uploadScreen) els.uploadScreen.classList.add('hidden');
        if (els.pdfWorkspace) els.pdfWorkspace.classList.remove('hidden');

        if (els.editingToolsGroup) els.editingToolsGroup.classList.remove('opacity-40', 'pointer-events-none');
        if (els.autoscrollGroup) els.autoscrollGroup.classList.remove('opacity-40', 'pointer-events-none');
        if (els.btnAutoScrollMobile) els.btnAutoScrollMobile.classList.remove('opacity-40', 'pointer-events-none');
        if (els.btnSavePdf) els.btnSavePdf.disabled = false;

        const containerWidth = Math.max(320, (els.scrollContainer ? els.scrollContainer.clientWidth : window.innerWidth) - 48);
        const firstPage = await state.pdfDoc.getPage(1);
        const viewport = firstPage.getViewport({ scale: 1 });
        state.renderScale = Math.max(1.0, Math.min(1.65, Math.min(880, containerWidth) / viewport.width));

        for (let pageNum = 1; pageNum <= state.numPages; pageNum++) {
          const pct = Math.round((pageNum / state.numPages) * 90) + 10;
          updateLoadingProgress(`Rendering page ${pageNum} of ${state.numPages}...`, pct);
          await renderSinglePdfPage(pageNum);
        }

        highlightActivePageWrapper(1);
        applyToolToAllCanvases(state.currentTool);
        hideLoading();
        showToast(`Loaded "${fileName}" (${state.numPages} pages)`, 'success');
      } catch (err) {
        console.error('Error loading PDF:', err);
        hideLoading();
        showToast('Failed to load PDF file.', 'error');
      }
    }

    async function renderSinglePdfPage(pageNumber) {
      const page = await state.pdfDoc.getPage(pageNumber);
      const viewport = page.getViewport({ scale: state.renderScale });
      const width = Math.floor(viewport.width);
      const height = Math.floor(viewport.height);

      const wrapperEl = document.createElement('div');
      wrapperEl.className = 'pdf-page-wrapper';
      wrapperEl.style.width = `${width}px`;
      wrapperEl.style.height = `${height}px`;
      wrapperEl.dataset.pageNumber = pageNumber;

      const bgCanvas = document.createElement('canvas');
      bgCanvas.className = 'pdf-bg-canvas';
      bgCanvas.width = width;
      bgCanvas.height = height;

      const overlayHolder = document.createElement('div');
      overlayHolder.className = 'fabric-overlay-wrapper';
      const fabricCanvasEl = document.createElement('canvas');
      fabricCanvasEl.width = width;
      fabricCanvasEl.height = height;
      overlayHolder.appendChild(fabricCanvasEl);

      const pageBadge = document.createElement('div');
      pageBadge.className = 'absolute bottom-2 right-3 z-20 px-2 py-0.5 rounded bg-slate-900/50 text-white text-[10px] font-medium pointer-events-none backdrop-blur-sm';
      pageBadge.textContent = `Page ${pageNumber}`;

      wrapperEl.appendChild(bgCanvas);
      wrapperEl.appendChild(overlayHolder);
      wrapperEl.appendChild(pageBadge);
      if (els.pagesList) els.pagesList.appendChild(wrapperEl);

      await page.render({ canvasContext: bgCanvas.getContext('2d'), viewport }).promise;

      const fabricCanvas = new fabric.Canvas(fabricCanvasEl, { width, height, selection: true, preserveObjectStacking: true });
      fabric.Object.prototype.set({ transparentCorners: false, cornerColor: '#6366f1', cornerStrokeColor: '#ffffff', borderColor: '#6366f1', cornerSize: 10, padding: 6, cornerStyle: 'circle' });

      const initialJson = JSON.stringify(fabricCanvas.toJSON(['isHighlight']));
      state.history.pageSnapshots.set(pageNumber, initialJson);

      setupFabricCanvasEvents(fabricCanvas, pageNumber);
      state.pagesData.push({ pageNumber, wrapperEl, bgCanvas, fabricCanvas, width, height });
    }

    function setupFabricCanvasEvents(fabricCanvas, pageNumber) {
      let isDragging = false;
      let startX = 0, startY = 0;
      let activeShape = null;

      fabricCanvas.on('mouse:down', (opt) => {
        setActivePage(pageNumber);
        state.pagesData.forEach(p => { if (p.pageNumber !== pageNumber) p.fabricCanvas.discardActiveObject().requestRenderAll(); });

        const pointer = fabricCanvas.getPointer(opt.e);

        if (state.currentTool === 'text' && !opt.target) {
          const iText = new fabric.IText('Type here...', { left: pointer.x, top: pointer.y, fontFamily: 'Inter, sans-serif', fontSize: Number(state.fontSize) || 24, fill: state.textColor, editable: true });
          fabricCanvas.add(iText);
          fabricCanvas.setActiveObject(iText);
          iText.enterEditing();
          iText.selectAll();
          fabricCanvas.requestRenderAll();
          setTool('select');
          return;
        }

        if (state.currentTool === 'highlight-box' || state.currentTool === 'pen-line') {
          isDragging = true;
          startX = pointer.x;
          startY = pointer.y;

          if (state.currentTool === 'highlight-box') {
            activeShape = new fabric.Rect({ left: startX, top: startY, width: 1, height: 1, fill: getHighlightRgba(state.highlightColorName, state.highlightOpacity), rx: 4, ry: 4, selectable: true, isHighlight: true });
          } else {
            activeShape = new fabric.Line([startX, startY, startX, startY], { stroke: state.penColor, strokeWidth: Number(state.penWidth), selectable: true, strokeLineCap: 'round' });
          }
          fabricCanvas.add(activeShape);
        }
      });

      fabricCanvas.on('mouse:move', (opt) => {
        if (!isDragging || !activeShape) return;
        const pointer = fabricCanvas.getPointer(opt.e);

        if (state.currentTool === 'highlight-box') {
          const left = Math.min(startX, pointer.x);
          const top = Math.min(startY, pointer.y);
          const width = Math.abs(pointer.x - startX);
          const height = Math.abs(pointer.y - startY);
          activeShape.set({ left, top, width, height });
        } else if (state.currentTool === 'pen-line') {
          activeShape.set({ x2: pointer.x, y2: pointer.y });
        }
        fabricCanvas.requestRenderAll();
      });

      fabricCanvas.on('mouse:up', () => {
        if (isDragging && activeShape) {
          isDragging = false;
          activeShape.setCoords();
          recordCanvasHistory(pageNumber);
          activeShape = null;
        }
      });

      fabricCanvas.on('path:created', (e) => {
        if (e.path) {
          if (state.currentTool === 'highlight-free') {
            e.path.set({ isHighlight: true, stroke: getHighlightRgba(state.highlightColorName, state.highlightOpacity) });
          }
        }
        recordCanvasHistory(pageNumber);
      });

      fabricCanvas.on('object:added', (e) => {
        if (state.history.isRestoring) return;
        if (isDragging && e.target === activeShape) return;
        if (e.target && e.target.type === 'path' && fabricCanvas.isDrawingMode) return;
        recordCanvasHistory(pageNumber);
      });
      fabricCanvas.on('object:modified', () => { if (!state.history.isRestoring) recordCanvasHistory(pageNumber); });
      fabricCanvas.on('object:removed', () => { if (!state.history.isRestoring) recordCanvasHistory(pageNumber); });
    }

    function recordCanvasHistory(pageNumber) {
      if (state.history.isRestoring) return;
      const pageObj = state.pagesData.find(p => p.pageNumber === pageNumber);
      if (!pageObj) return;

      const prevJson = state.history.pageSnapshots.get(pageNumber);
      const nextJson = JSON.stringify(pageObj.fabricCanvas.toJSON(['isHighlight']));
      if (prevJson === nextJson) return;

      state.history.undoStack.push({ pageNumber, prevJson, nextJson });
      if (state.history.undoStack.length > 60) state.history.undoStack.shift();
      state.history.redoStack = [];
      state.history.pageSnapshots.set(pageNumber, nextJson);
      updateUndoRedoButtons();
    }

    function performUndo() {
      if (state.history.undoStack.length === 0) return;
      const action = state.history.undoStack.pop();
      state.history.redoStack.push(action);
      restorePageCanvasState(action.pageNumber, action.prevJson);
      updateUndoRedoButtons();
    }

    function performRedo() {
      if (state.history.redoStack.length === 0) return;
      const action = state.history.redoStack.pop();
      state.history.undoStack.push(action);
      restorePageCanvasState(action.pageNumber, action.nextJson);
      updateUndoRedoButtons();
    }

    function restorePageCanvasState(pageNumber, jsonString) {
      const pageObj = state.pagesData.find(p => p.pageNumber === pageNumber);
      if (!pageObj) return;
      state.history.isRestoring = true;
      pageObj.fabricCanvas.loadFromJSON(jsonString, () => {
        pageObj.fabricCanvas.renderAll();
        state.history.pageSnapshots.set(pageNumber, jsonString);
        state.history.isRestoring = false;
        setActivePage(pageNumber);
      });
    }

    function updateUndoRedoButtons() {
      if (els.btnUndo) els.btnUndo.disabled = state.history.undoStack.length === 0;
      if (els.btnRedo) els.btnRedo.disabled = state.history.redoStack.length === 0;
    }

    function setTool(toolName) {
      state.currentTool = toolName;
      if (els.toolButtons) {
        els.toolButtons.forEach(btn => {
          const match = btn.dataset.tool === toolName;
          btn.classList.toggle('bg-indigo-50', match);
          btn.classList.toggle('text-indigo-600', match);
          btn.classList.toggle('dark:bg-indigo-500/20', match);
          btn.classList.toggle('dark:text-indigo-300', match);
          btn.classList.toggle('ring-1', match);
          btn.classList.toggle('ring-indigo-500/30', match);
        });
      }

      const labels = {
        'select': 'Select & Move Mode',
        'text': 'Add Text Mode (Click page)',
        'highlight-free': 'Freehand Highlighter',
        'highlight-box': 'Box Highlighter',
        'pen-free': 'Pen Freehand (Red)',
        'pen-line': 'Pen Straight Line'
      };
      if (els.activeToolBadge) els.activeToolBadge.textContent = labels[toolName] || 'Select Mode';
      applyToolToAllCanvases(toolName);
    }

    function applyToolToAllCanvases(toolName) {
      state.pagesData.forEach(({ fabricCanvas }) => {
        const activeObj = fabricCanvas.getActiveObject();
        if (activeObj && activeObj.isEditing) activeObj.exitEditing();

        if (toolName === 'highlight-free') {
          fabricCanvas.isDrawingMode = true;
          const brush = new fabric.PencilBrush(fabricCanvas);
          brush.color = getHighlightRgba(state.highlightColorName, state.highlightOpacity);
          brush.width = 24;
          fabricCanvas.freeDrawingBrush = brush;
          fabricCanvas.defaultCursor = 'crosshair';
        } else if (toolName === 'pen-free') {
          fabricCanvas.isDrawingMode = true;
          const brush = new fabric.PencilBrush(fabricCanvas);
          brush.color = state.penColor;
          brush.width = Number(state.penWidth);
          fabricCanvas.freeDrawingBrush = brush;
          fabricCanvas.defaultCursor = 'crosshair';
        } else if (toolName === 'highlight-box' || toolName === 'pen-line') {
          fabricCanvas.isDrawingMode = false;
          fabricCanvas.selection = false;
          fabricCanvas.defaultCursor = 'crosshair';
          fabricCanvas.forEachObject(o => { o.selectable = false; });
        } else {
          fabricCanvas.isDrawingMode = false;
          fabricCanvas.selection = true;
          fabricCanvas.defaultCursor = 'default';
          fabricCanvas.forEachObject(o => { o.selectable = true; });
        }
        fabricCanvas.requestRenderAll();
      });
    }

    /* Insert Symbols / Shapes */
    function insertShapeOrSymbol(type) {
      const pageObj = state.pagesData.find(p => p.pageNumber === state.activePageIndex) || state.pagesData[0];
      if (!pageObj) return;
      const canvas = pageObj.fabricCanvas;
      const cx = pageObj.width / 2;
      const cy = pageObj.height / 2;

      let obj = null;
      if (type === 'rectangle') {
        obj = new fabric.Rect({ left: cx - 50, top: cy - 35, width: 100, height: 70, fill: 'transparent', stroke: state.penColor, strokeWidth: 3 });
      } else if (type === 'circle') {
        obj = new fabric.Circle({ left: cx - 40, top: cy - 40, radius: 40, fill: 'transparent', stroke: state.penColor, strokeWidth: 3 });
      } else if (type === 'triangle') {
        obj = new fabric.Triangle({ left: cx - 45, top: cy - 45, width: 90, height: 90, fill: 'transparent', stroke: state.penColor, strokeWidth: 3 });
      } else if (type === 'star') {
        const points = [{x:0, y:-30}, {x:8, y:-10}, {x:30, y:-10}, {x:12, y:4}, {x:18, y:25}, {x:0, y:12}, {x:-18, y:25}, {x:-12, y:4}, {x:-30, y:-10}, {x:-8, y:-10}];
        obj = new fabric.Polygon(points, { left: cx - 20, top: cy - 20, fill: '#f59e0b', stroke: '#d97706', strokeWidth: 2, scaleX: 1.5, scaleY: 1.5 });
      } else if (type === 'check') {
        obj = new fabric.Text('✓', { left: cx - 20, top: cy - 25, fontSize: 50, fill: '#10b981', fontFamily: 'Inter' });
      } else if (type === 'cross') {
        obj = new fabric.Text('✕', { left: cx - 20, top: cy - 25, fontSize: 45, fill: '#ef4444', fontFamily: 'Inter' });
      } else if (type === 'question') {
        obj = new fabric.Text('?', { left: cx - 15, top: cy - 25, fontSize: 45, fill: '#6366f1', fontFamily: 'Inter', fontWeight: 'bold' });
      } else if (type === 'arrow-single') {
        obj = new fabric.Group([
          new fabric.Line([0, 0, 100, 0], { stroke: state.penColor, strokeWidth: 3, originX: 'left', originY: 'center' }),
          new fabric.Triangle({ left: 100, top: 0, width: 12, height: 16, fill: state.penColor, angle: 90, originX: 'center', originY: 'center' })
        ], { left: cx - 50, top: cy, selectable: true });
      } else if (type === 'arrow-double') {
        obj = new fabric.Group([
          new fabric.Line([-50, 0, 50, 0], { stroke: state.penColor, strokeWidth: 3, originX: 'center', originY: 'center' }),
          new fabric.Triangle({ left: -50, top: 0, width: 12, height: 16, fill: state.penColor, angle: -90, originX: 'center', originY: 'center' }),
          new fabric.Triangle({ left: 50, top: 0, width: 12, height: 16, fill: state.penColor, angle: 90, originX: 'center', originY: 'center' })
        ], { left: cx - 50, top: cy, selectable: true });
      } else if (type === 'hand') {
        obj = new fabric.Text('☞', { left: cx - 25, top: cy - 25, fontSize: 48, fill: '#f59e0b', fontFamily: 'Inter' });
      }

      if (obj) {
        setTool('select');
        canvas.add(obj);
        canvas.setActiveObject(obj);
        canvas.requestRenderAll();
        showToast(`Added symbol to Page ${pageObj.pageNumber}`, 'success');
      }
      if (els.symbolsDropdown) els.symbolsDropdown.classList.add('hidden');
    }

    /* Speech-to-Text Voice Dictation */
    function toggleSpeechDictation() {
      const SpeechRecognitionAPI = window.SpeechRecognition || window.webkitSpeechRecognition;
      if (!SpeechRecognitionAPI) {
        showToast('Speech recognition is not supported in this browser. Try Google Chrome.', 'error');
        return;
      }

      if (state.isListening) {
        if (state.speechRecognition) state.speechRecognition.stop();
        return;
      }

      try {
        state.speechRecognition = new SpeechRecognitionAPI();
        state.speechRecognition.continuous = false;
        state.speechRecognition.interimResults = false;
        state.speechRecognition.lang = 'en-US';

        state.speechRecognition.onstart = () => {
          state.isListening = true;
          if (els.speechIcon) els.speechIcon.setAttribute('data-lucide', 'mic-off');
          if (els.btnSpeechDictate) els.btnSpeechDictate.classList.add('bg-indigo-100', 'dark:bg-indigo-900', 'text-indigo-600', 'animate-pulse');
          lucide.createIcons();
          showToast('Listening... Speak now to add text.', 'success');
        };

        state.speechRecognition.onresult = (event) => {
          const transcript = event.results[0][0].transcript;
          if (transcript) {
            const pageObj = state.pagesData.find(p => p.pageNumber === state.activePageIndex) || state.pagesData[0];
            if (pageObj) {
              const cx = pageObj.width / 2 - 100;
              const cy = pageObj.height / 2;
              const iText = new fabric.IText(transcript, { left: cx, top: cy, fontFamily: 'Inter, sans-serif', fontSize: Number(state.fontSize) || 24, fill: state.textColor, editable: true });
              pageObj.fabricCanvas.add(iText);
              pageObj.fabricCanvas.setActiveObject(iText);
              pageObj.fabricCanvas.requestRenderAll();
              showToast(`Dictated: "${transcript}"`, 'success');
            }
          }
        };

        state.speechRecognition.onerror = (e) => {
          console.error(e);
          showToast('Voice recognition error: ' + e.error, 'error');
          stopSpeechDictationUI();
        };

        state.speechRecognition.onend = () => {
          stopSpeechDictationUI();
        };

        state.speechRecognition.start();
      } catch (err) {
        console.error(err);
        showToast('Could not start speech recognition.', 'error');
        stopSpeechDictationUI();
      }
    }

    function stopSpeechDictationUI() {
      state.isListening = false;
      if (els.speechIcon) els.speechIcon.setAttribute('data-lucide', 'mic');
      if (els.btnSpeechDictate) els.btnSpeechDictate.classList.remove('bg-indigo-100', 'dark:bg-indigo-900', 'text-indigo-600', 'animate-pulse');
      lucide.createIcons();
    }

    function handleImageUpload(file) {
      if (!file || state.pagesData.length === 0) return;
      const reader = new FileReader();
      reader.onload = (e) => {
        fabric.Image.fromURL(e.target.result, (img) => {
          const pageObj = state.pagesData.find(p => p.pageNumber === state.activePageIndex) || state.pagesData[0];
          const maxW = pageObj.width * 0.45;
          const maxH = pageObj.height * 0.45;
          let scale = 1;
          if (img.width > maxW || img.height > maxH) scale = Math.min(maxW / img.width, maxH / img.height);

          img.set({ left: (pageObj.width - img.width * scale) / 2, top: (pageObj.height - img.height * scale) / 2, scaleX: scale, scaleY: scale });
          setTool('select');
          pageObj.fabricCanvas.add(img);
          pageObj.fabricCanvas.setActiveObject(img);
          pageObj.fabricCanvas.requestRenderAll();
          showToast(`Image added to Page ${pageObj.pageNumber}`, 'success');
        });
      };
      reader.readAsDataURL(file);
    }

    function deleteSelectedObject() {
      let count = 0;
      state.pagesData.forEach(({ fabricCanvas, pageNumber }) => {
        const objs = fabricCanvas.getActiveObjects();
        if (objs && objs.length > 0) {
          const single = fabricCanvas.getActiveObject();
          if (single && single.isEditing) return;
          state.history.isRestoring = true;
          objs.forEach(o => fabricCanvas.remove(o));
          fabricCanvas.discardActiveObject().requestRenderAll();
          state.history.isRestoring = false;
          recordCanvasHistory(pageNumber);
          count += objs.length;
        }
      });
      if (count > 0) showToast(`Deleted ${count} item(s)`);
      else showToast('Select an element on the page first to delete.');
    }

    function setActivePage(num) {
      state.activePageIndex = num;
      if (els.currentPageIndicator) els.currentPageIndicator.textContent = String(num);
      state.pagesData.forEach(p => p.wrapperEl.classList.toggle('active-page-ring', p.pageNumber === num));
    }

    if (els.scrollContainer) {
      els.scrollContainer.addEventListener('scroll', () => {
        if (state.pagesData.length === 0) return;
        const rect = els.scrollContainer.getBoundingClientRect();
        const center = rect.top + rect.height * 0.35;
        let closest = state.activePageIndex;
        let minDist = Infinity;
        state.pagesData.forEach(p => {
          const r = p.wrapperEl.getBoundingClientRect();
          const dist = Math.abs(r.top - center);
          if (dist < minDist) { minDist = dist; closest = p.pageNumber; }
        });
        if (closest !== state.activePageIndex) setActivePage(closest);
      });
    }

    function toggleAutoScroll() {
      if (state.pagesData.length === 0) return;
      if (state.autoScroll.active) stopAutoScroll();
      else startAutoScroll();
    }
    function startAutoScroll() {
      state.autoScroll.active = true;
      if (els.scrollContainer) els.scrollContainer.classList.add('auto-scrolling');
      updateAutoScrollUI();
      let last = performance.now();
      function step(now) {
        if (!state.autoScroll.active) return;
        const dt = (now - last) / 1000;
        last = now;
        if (els.scrollContainer) {
          els.scrollContainer.scrollTop += state.autoScroll.speed * 38 * dt;
          const max = els.scrollContainer.scrollHeight - els.scrollContainer.clientHeight;
          if (els.scrollContainer.scrollTop >= max - 1) { stopAutoScroll(); showToast('Reached end of document.'); return; }
        }
        state.autoScroll.rafId = requestAnimationFrame(step);
      }
      state.autoScroll.rafId = requestAnimationFrame(step);
    }
    function stopAutoScroll() {
      state.autoScroll.active = false;
      if (els.scrollContainer) els.scrollContainer.classList.remove('auto-scrolling');
      if (state.autoScroll.rafId) { cancelAnimationFrame(state.autoScroll.rafId); state.autoScroll.rafId = null; }
      updateAutoScrollUI();
    }
    function updateAutoScrollUI() {
      const name = state.autoScroll.active ? 'pause' : 'play';
      if (els.autoScrollIcon) els.autoScrollIcon.setAttribute('data-lucide', name);
      if (els.autoScrollMobileIcon) els.autoScrollMobileIcon.setAttribute('data-lucide', name);
      if (els.mobileAutoScrollBar) {
        if (state.autoScroll.active) els.mobileAutoScrollBar.classList.remove('hidden');
        else els.mobileAutoScrollBar.classList.add('hidden');
      }
      lucide.createIcons();
    }
    function setSpeed(v) {
      state.autoScroll.speed = Number(v) || 2;
      if (els.autoScrollSpeed) els.autoScrollSpeed.value = String(state.autoScroll.speed);
      if (els.autoScrollSpeedMobile) els.autoScrollSpeedMobile.value = String(state.autoScroll.speed);
      if (els.autoScrollSpeedLabel) els.autoScrollSpeedLabel.textContent = `${state.autoScroll.speed}x`;
      if (els.autoScrollSpeedMobileLabel) els.autoScrollSpeedMobileLabel.textContent = `${state.autoScroll.speed}x`;
    }

    function toggleDarkMode() {
      state.isDarkMode = !state.isDarkMode;
      document.documentElement.classList.toggle('dark', state.isDarkMode);
      if (els.pagesList) els.pagesList.classList.toggle('pdf-invert', state.isDarkMode);
      if (els.darkModeIcon) els.darkModeIcon.setAttribute('data-lucide', state.isDarkMode ? 'sun' : 'moon');
      lucide.createIcons();
      showToast(state.isDarkMode ? 'Dark Mode & PDF Invert enabled' : 'Light mode restored');
    }

    function toggleFullScreen() {
      if (!document.fullscreenElement) document.documentElement.requestFullscreen().catch(e => showToast(e.message, 'error'));
      else document.exitFullscreen();
    }
    document.addEventListener('fullscreenchange', () => {
      const full = Boolean(document.fullscreenElement);
      if (els.fullscreenIcon) els.fullscreenIcon.setAttribute('data-lucide', full ? 'minimize' : 'maximize');
      if (els.floatingExitFullscreen) els.floatingExitFullscreen.classList.toggle('hidden', !full);
      lucide.createIcons();
    });

    async function exportModifiedPdf() {
      if (!state.pdfBytes || state.pagesData.length === 0) return;
      try {
        stopAutoScroll();
        showLoading('Saving Modified PDF...', 'Flattening annotations and symbols', 15);

        state.pagesData.forEach(({ fabricCanvas }) => {
          const obj = fabricCanvas.getActiveObject();
          if (obj && obj.isEditing) obj.exitEditing();
          fabricCanvas.discardActiveObject().renderAll();
        });

        const { PDFDocument } = PDFLib;
        const pdfDoc = await PDFDocument.load(state.pdfBytes);
        const pdfPages = pdfDoc.getPages();

        for (let i = 0; i < state.pagesData.length; i++) {
          const { fabricCanvas, pageNumber } = state.pagesData[i];
          updateLoadingProgress(`Merging page ${pageNumber} of ${state.numPages}...`, Math.round(((i + 1) / state.pagesData.length) * 75) + 15);
          if (fabricCanvas.getObjects().length > 0) {
            const dataUrl = fabricCanvas.toDataURL({ format: 'png', multiplier: 2, enableRetinaScaling: true });
            const png = await pdfDoc.embedPng(dataUrl);
            const pg = pdfPages[i];
            const { width, height } = pg.getSize();
            pg.drawImage(png, { x: 0, y: 0, width, height });
          }
        }

        updateLoadingProgress('Generating final PDF...', 95);
        const bytes = await pdfDoc.save();
        const blob = new Blob([bytes], { type: 'application/pdf' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `${state.fileName.replace(/\.pdf$/i, '')}-edited.pdf`;
        document.body.appendChild(a);
        a.click();
        a.remove();
        setTimeout(() => URL.revokeObjectURL(url), 5000);

        hideLoading();
        showToast('Saved & downloaded modified PDF!', 'success');
      } catch (err) {
        console.error(err);
        hideLoading();
        showToast('Failed to export PDF.', 'error');
      }
    }

    /* Event Listeners Setup with Robust Null Checks */
    if (els.btnSelectPdf) els.btnSelectPdf.addEventListener('click', (e) => { e.stopPropagation(); if (els.pdfFileInput) els.pdfFileInput.click(); });
    if (els.btnUploadNew) els.btnUploadNew.addEventListener('click', () => { if (els.pdfFileInput) els.pdfFileInput.click(); });
    if (els.dropZone) {
      els.dropZone.addEventListener('click', (e) => { if (!e.target.closest('button') && els.pdfFileInput) els.pdfFileInput.click(); });
    }
    if (els.pdfFileInput) {
      els.pdfFileInput.addEventListener('change', async (e) => {
        const f = e.target.files[0];
        if (f) await loadPdfFromBytes(new Uint8Array(await f.arrayBuffer()), f.name);
        els.pdfFileInput.value = '';
      });
    }

    ['dragenter', 'dragover'].forEach(n => window.addEventListener(n, e => { e.preventDefault(); if (els.dropZone) els.dropZone.classList.add('border-indigo-500', 'bg-indigo-500/10'); }));
    ['dragleave', 'drop'].forEach(n => window.addEventListener(n, e => { e.preventDefault(); if (els.dropZone) els.dropZone.classList.remove('border-indigo-500', 'bg-indigo-500/10'); }));
    window.addEventListener('drop', async (e) => {
      const f = e.dataTransfer?.files?.[0];
      if (f?.type === 'application/pdf' || f?.name?.toLowerCase()?.endsWith('.pdf')) {
        await loadPdfFromBytes(new Uint8Array(await f.arrayBuffer()), f.name);
      } else if (f?.type?.startsWith('image/') && state.pagesData.length > 0) {
        handleImageUpload(f);
      }
    });

    if (els.btnLoadSample) {
      els.btnLoadSample.addEventListener('click', async (e) => {
        e.stopPropagation();
        showLoading('Creating Sample PDF...', 'Generating 3-page template', 30);
        await loadPdfFromBytes(await generateSamplePdfBytes(), 'Sample-Professional-Guide.pdf');
      });
    }

    if (els.toolButtons) {
      els.toolButtons.forEach(btn => btn.addEventListener('click', () => { if (btn.dataset.tool) setTool(btn.dataset.tool); }));
    }
    if (els.toolImage) els.toolImage.addEventListener('click', () => { if (els.imageFileInput) els.imageFileInput.click(); });
    if (els.imageFileInput) {
      els.imageFileInput.addEventListener('change', (e) => { if (e.target.files[0]) handleImageUpload(e.target.files[0]); els.imageFileInput.value = ''; });
    }

    // Symbols & Shapes dropdown toggle
    if (els.btnSymbolsMenu && els.symbolsDropdown) {
      els.btnSymbolsMenu.addEventListener('click', (e) => { e.stopPropagation(); els.symbolsDropdown.classList.toggle('hidden'); });
      document.addEventListener('click', () => els.symbolsDropdown.classList.add('hidden'));
    }
    if (els.shapeItems) {
      els.shapeItems.forEach(item => item.addEventListener('click', (e) => {
        e.stopPropagation();
        insertShapeOrSymbol(item.dataset.shape);
      }));
    }

    if (els.btnSpeechDictate) els.btnSpeechDictate.addEventListener('click', toggleSpeechDictation);

    // Text & Color controls
    if (els.textSizeSelect) {
      els.textSizeSelect.addEventListener('change', (e) => {
        state.fontSize = Number(e.target.value) || 24;
        state.pagesData.forEach(({ fabricCanvas, pageNumber }) => {
          const obj = fabricCanvas.getActiveObject();
          if (obj && (obj.type === 'i-text' || obj.type === 'text')) {
            obj.set('fontSize', state.fontSize);
            fabricCanvas.requestRenderAll();
            recordCanvasHistory(pageNumber);
          }
        });
      });
    }
    if (els.textColorPicker) {
      els.textColorPicker.addEventListener('input', (e) => {
        state.textColor = e.target.value;
        state.pagesData.forEach(({ fabricCanvas, pageNumber }) => {
          const obj = fabricCanvas.getActiveObject();
          if (obj && (obj.type === 'i-text' || obj.type === 'text')) {
            obj.set('fill', state.textColor);
            fabricCanvas.requestRenderAll();
            recordCanvasHistory(pageNumber);
          }
        });
      });
    }

    // Highlighter Swatches & Opacity
    if (els.hlSwatches) {
      els.hlSwatches.forEach(sw => sw.addEventListener('click', () => {
        state.highlightColorName = sw.dataset.hlColor;
        els.hlSwatches.forEach(s => { s.classList.remove('ring-2', 'ring-offset-1', 'ring-slate-900', 'dark:ring-white', 'opacity-100'); s.classList.add('opacity-75'); });
        sw.classList.remove('opacity-75');
        sw.classList.add('ring-2', 'ring-offset-1', 'ring-slate-900', 'dark:ring-white', 'opacity-100');
        if (state.currentTool !== 'highlight-free' && state.currentTool !== 'highlight-box') setTool('highlight-free');
        else applyToolToAllCanvases(state.currentTool);
      }));
    }
    if (els.hlOpacitySlider) {
      els.hlOpacitySlider.addEventListener('input', (e) => {
        state.highlightOpacity = Number(e.target.value) || 0.4;
        if (state.currentTool === 'highlight-free' || state.currentTool === 'highlight-box') applyToolToAllCanvases(state.currentTool);
      });
    }

    // Pen Controls
    if (els.penColorPicker) {
      els.penColorPicker.addEventListener('input', (e) => {
        state.penColor = e.target.value;
        if (state.currentTool === 'pen-free') applyToolToAllCanvases('pen-free');
      });
    }
    if (els.penWidthSlider) {
      els.penWidthSlider.addEventListener('input', (e) => {
        state.penWidth = Number(e.target.value) || 3;
        if (state.currentTool === 'pen-free') applyToolToAllCanvases('pen-free');
      });
    }

    if (els.btnUndo) els.btnUndo.addEventListener('click', performUndo);
    if (els.btnRedo) els.btnRedo.addEventListener('click', performRedo);
    if (els.btnDelete) els.btnDelete.addEventListener('click', deleteSelectedObject);

    if (els.btnAutoScrollToggle) els.btnAutoScrollToggle.addEventListener('click', toggleAutoScroll);
    if (els.btnAutoScrollMobile) els.btnAutoScrollMobile.addEventListener('click', toggleAutoScroll);
    if (els.autoScrollSpeed) els.autoScrollSpeed.addEventListener('input', e => setSpeed(e.target.value));
    if (els.autoScrollSpeedMobile) els.autoScrollSpeedMobile.addEventListener('input', e => setSpeed(e.target.value));

    if (els.btnDarkMode) els.btnDarkMode.addEventListener('click', toggleDarkMode);
    if (els.btnFullscreen) els.btnFullscreen.addEventListener('click', toggleFullScreen);
    if (els.floatingExitFullscreen) els.floatingExitFullscreen.addEventListener('click', toggleFullScreen);
    if (els.btnSavePdf) els.btnSavePdf.addEventListener('click', exportModifiedPdf);

    window.addEventListener('keydown', (e) => {
      if (state.pagesData.length === 0) return;
      const tag = document.activeElement?.tagName?.toLowerCase();
      if (tag === 'input' || tag === 'select' || tag === 'textarea') return;
      const editing = state.pagesData.some(p => p.fabricCanvas.getActiveObject()?.isEditing);
      if (editing) return;

      if ((e.ctrlKey || e.metaKey) && !e.shiftKey && e.key.toLowerCase() === 'z') { e.preventDefault(); performUndo(); return; }
      if ((e.ctrlKey || e.metaKey) && (e.key.toLowerCase() === 'y' || (e.shiftKey && e.key.toLowerCase() === 'z'))) { e.preventDefault(); performRedo(); return; }
      if (e.key === 'Delete' || e.key === 'Backspace') { e.preventDefault(); deleteSelectedObject(); return; }

      if (!e.ctrlKey && !e.metaKey && !e.altKey) {
        const k = e.key.toLowerCase();
        if (k === 'v') setTool('select');
        else if (k === 't') setTool('text');
        else if (k === 'h') setTool('highlight-free');
        else if (k === 'b') setTool('highlight-box');
        else if (k === 'p') setTool('pen-free');
        else if (k === 'l') setTool('pen-line');
        else if (k === 'i') { if (els.imageFileInput) els.imageFileInput.click(); }
      }
    });
  </script>
</body>
</html>
